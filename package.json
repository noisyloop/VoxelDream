{
  "name": "voxeldream",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "A browser-based voxel world builder that teaches computer graphics by making you earn every tool you use.",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:no-binaries && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run check:no-binaries && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:no-binaries": "node scripts/check-no-binaries.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webgpu/types": "^0.1.60",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "zustand": "^5.0.0"
  },
  "engines": {
    "node": "24.x"
  }
}
